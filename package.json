{
  "name": "aquastar-ruffle",
  "version": "1.1.1",
  "main": "main.js",
  "autor": "aquasp",
  "description": "The ruffle launcher to play AQW!",
  "repository": {
    "type": "git",
    "url": "https://github.com/aquaspy/aquastar-ruffle.git"
  },
  "build": {
    "appId": "aquastar.ruffle",
    "productName": "Aquastar Ruffle",
    "asar": true,
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "aquaspy",
      "repo": "aquastar-ruffle"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "compression": "normal",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "icon": "Icon.png"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12"
  }
}
